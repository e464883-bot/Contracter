# Copia a .env.standby y completa el archivo privado.
CONTRACTER_TELEGRAM_BOT_TOKEN=TODO_INSERT_BOT_TOKEN_HERE
CONTRACTER_TELEGRAM_CHAT_ID=TODO_INSERT_PRIVATE_CHAT_ID_HERE
CONTRACTER_TELEGRAM_OWNER_ID=TODO_INSERT_TELEGRAM_USER_ID_HERE
CONTRACTER_STORE_URL=https://PROJECT_REF.supabase.co/functions/v1/contracter-store
CONTRACTER_STORE_TELEGRAM_TOKEN=TODO_INSERT_TELEGRAM_STORE_TOKEN_HERE
CONTRACTER_STORE_AUDIT_TOKEN=TODO_INSERT_AUDIT_STORE_TOKEN_HERE
CONTRACTER_GEMINI_API_KEY=TODO_INSERT_GEMINI_API_KEY_HERE

# Opcional. El selector del panel cambia el operador del bot con estas credenciales.
CONTRACTER_OPERATOR_ENABLED=false
CONTRACTER_OPERATOR_TOKEN=TODO_INSERT_SEPARATE_PRIVATE_OPERATOR_TOKEN_HERE
CONTRACTER_OPERATOR_N8N_URL=https://YOUR_INSTANCE.app.n8n.cloud
CONTRACTER_OPERATOR_N8N_API_KEY=TODO_INSERT_N8N_API_KEY_HERE
CONTRACTER_OPERATOR_N8N_WORKFLOW_ID=TODO_INSERT_TELEGRAM_TRIGGER_WORKFLOW_ID_HERE
CONTRACTER_OPERATOR_N8N_WEBHOOK_URL=https://YOUR_INSTANCE.app.n8n.cloud/webhook/YOUR_TELEGRAM_WEBHOOK_PATH
