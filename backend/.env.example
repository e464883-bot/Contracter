# Configuración privada del gateway. Node 24 admite --env-file.
# Este archivo no contiene secretos; llene una copia local fuera de docs/.
CONTRACTER_MODE=mock
CONTRACTER_PORT=8780
# Mínimo 32 caracteres aleatorios, sólo backend. No usar una clave de proveedor aquí.
CONTRACTER_DASHBOARD_TOKEN=
CONTRACTER_ALLOWED_ORIGINS=
CONTRACTER_SQLITE_PATH=

# Live sólo usa Supabase. SQLite queda limitado a fixtures mock locales.
SUPABASE_URL=TODO_INSERT_KEY_HERE
# Preferir el secreto moderno sb_secret_...; nunca se envía al navegador.
SUPABASE_SECRET_KEY=
# Compatibilidad con el JWT legado del scaffold original, si ya existe.
SUPABASE_SERVICE_ROLE_KEY=
CONTRACTER_LEGAL_RAG_ENABLED=false

# Sólo leerá la configuración para /health, sin llamadas de comprobación al inicio.
N8N_BASE_URL=TODO_INSERT_KEY_HERE
TELEGRAM_BOT_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# POST /voice/session requiere habilitación explícita y CONTRACTER_DASHBOARD_TOKEN.
# El resumen se limita a la demostración local o al expediente de evaluación configurado.
# Una conversación de voz puede consumir créditos del proveedor.
ELEVENLABS_ENABLED=false
ELEVENLABS_AGENT_ID=TODO_INSERT_KEY_HERE
ELEVENLABS_AGENT_BRANCH_ID=
ELEVENLABS_API_KEY=
