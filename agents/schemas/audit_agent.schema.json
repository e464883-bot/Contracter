{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditAgentOutputSchemaV2",
  "type": "object",
  "required": [
    "agent_name",
    "iteration",
    "consensus_reached",
    "status_for_fury",
    "observations"
  ],
  "properties": {
    "agent_name": {
      "type": "string"
    },
    "iteration": {
      "type": "integer"
    },
    "consensus_reached": {
      "type": "boolean"
    },
    "status_for_fury": {
      "type": "string",
      "enum": [
        "ENTENDIDO",
        "REQUIERE_CAMBIOS"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clause_reference",
          "severity",
          "issue_description",
          "proposed_fix"
        ],
        "properties": {
          "clause_reference": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "PANICO_CIUDADANO",
              "BAJA",
              "MEDIA",
              "ALTA",
              "CRITICA_ILEGAL",
              "ESCENARIO_TEORICO_REMOTO"
            ]
          },
          "issue_description": {
            "type": "string"
          },
          "proposed_fix": {
            "type": "string"
          }
        }
      }
    },
    "reassurance_for_morty": {
      "type": "array",
      "description": "Usado por Murdock, Harvey o Jarvis para explicarle a Morty en lenguaje simple por qué una cláusula aterradora es legalmente necesaria y segura.",
      "items": {
        "type": "object",
        "required": [
          "clause_reference",
          "expert_authority",
          "plain_explanation_for_morty"
        ],
        "properties": {
          "clause_reference": {
            "type": "string"
          },
          "expert_authority": {
            "type": "string",
            "enum": [
              "MURDOCK_LEGAL",
              "HARVEY_COMMERCIAL"
            ]
          },
          "plain_explanation_for_morty": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
