{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final_contract.schema.json",
  "title": "final_contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "live"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "legal_basis_status": {
          "type": "string",
          "enum": [
            "not_verified",
            "verified"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "retrieved_at"
            ]
          }
        }
      },
      "required": [
        "country",
        "region",
        "legal_basis_status",
        "sources"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "our_party": {
          "type": "string",
          "minLength": 1
        },
        "counterparty": {
          "type": "string",
          "minLength": 1
        },
        "our_role": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "our_party",
        "counterparty",
        "our_role",
        "objectives",
        "confirmed"
      ]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "const": "Afton"
        },
        "status": {
          "type": "string",
          "enum": [
            "CLEAN",
            "BLOCKED"
          ]
        },
        "sanitized_text": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "agent",
        "status",
        "sanitized_text",
        "findings",
        "limitations"
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "text",
            "sha256"
          ]
        },
        "v2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "text",
            "sha256"
          ]
        }
      },
      "required": [
        "v1",
        "v2"
      ]
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "Morty",
              "Harvey",
              "Murdock",
              "Lupin"
            ]
          },
          "reviewed_version": {
            "type": "string",
            "enum": [
              "V1",
              "V2"
            ]
          },
          "reviewed_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ENTENDIDO",
              "OBSERVADO",
              "PENDIENTE"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "clause": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ]
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "recommendation": {
                  "type": "string",
                  "minLength": 1
                },
                "resolved": {
                  "type": "boolean"
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "id",
                "clause",
                "severity",
                "observation",
                "recommendation",
                "resolved",
                "source_ids"
              ]
            }
          }
        },
        "required": [
          "agent",
          "reviewed_version",
          "reviewed_sha256",
          "status",
          "findings"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "house": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "const": "House"
        },
        "status": {
          "type": "string",
          "enum": [
            "CLEAN",
            "QUARANTINED"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agent": {
                "type": "string",
                "enum": [
                  "Fury",
                  "Afton",
                  "House",
                  "Jane",
                  "Sherlock",
                  "Morty",
                  "Harvey",
                  "Murdock",
                  "Lupin",
                  "Hamilton",
                  "Jarvis",
                  "Watson",
                  "Glenn"
                ]
              },
              "output_schema_valid": {
                "type": "boolean"
              },
              "anomaly_detected": {
                "type": "boolean"
              },
              "quarantine_required": {
                "type": "boolean"
              },
              "diagnostic": {
                "type": "string",
                "minLength": 1
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "agent",
              "output_schema_valid",
              "anomaly_detected",
              "quarantine_required",
              "diagnostic",
              "retry_count"
            ]
          },
          "minItems": 1
        },
        "contract_access": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "agent",
        "status",
        "checks",
        "contract_access",
        "limitations"
      ]
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "line_v1": {
            "type": "integer",
            "minimum": 0
          },
          "line_v2": {
            "type": "integer",
            "minimum": 0
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "operational_impact": {
            "type": "string",
            "minLength": 1
          },
          "addresses_finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "line_v1",
          "line_v2",
          "before",
          "after",
          "reason",
          "operational_impact",
          "addresses_finding_ids"
        ]
      },
      "minItems": 1
    },
    "calm_resolutions": {
      "description": "Alarmas ciudadanas de Morty resueltas con respaldo verificado para la huella exacta de V2, separadas de los cambios de texto.",
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "clause_reference": { "type": "string", "minLength": 1 },
          "expert_authority": { "type": "string", "enum": ["MURDOCK_LEGAL", "HARVEY_COMMERCIAL"] },
          "plain_explanation_for_morty": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "source_id": { "type": "string", "minLength": 1 },
          "reviewed_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["finding_id", "clause_reference", "expert_authority", "plain_explanation_for_morty", "source_id", "reviewed_sha256"]
      }
    },
    "fury": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "const": "Fury"
        },
        "status": {
          "type": "string",
          "enum": [
            "CONSENSUS",
            "HELD"
          ]
        },
        "released": {
          "type": "boolean"
        },
        "reviewed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "auditors_required": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Morty",
              "Harvey",
              "Murdock",
              "Lupin"
            ]
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "agent",
        "status",
        "released",
        "reviewed_sha256",
        "auditors_required",
        "rounds",
        "max_rounds"
      ]
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "approver": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "HMAC-SHA256"
            },
            "signature": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "algorithm",
            "signature"
          ]
        }
      },
      "required": [
        "required",
        "status",
        "approver",
        "approved_at",
        "approved_sha256",
        "evidence_reference",
        "attestation"
      ]
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watson": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "key_risks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "recommendations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "summary",
            "key_risks",
            "recommendations"
          ]
        },
        "glenn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "explanation"
          ]
        }
      },
      "required": [
        "watson",
        "glenn"
      ]
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD"
        },
        "pricing_status": {
          "type": "string",
          "enum": [
            "mock",
            "verified",
            "unverified"
          ]
        },
        "total_usd": {
          "type": "number",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "format": "uuid"
              },
              "agent": {
                "type": "string",
                "enum": [
                  "Fury",
                  "Afton",
                  "House",
                  "Jane",
                  "Sherlock",
                  "Morty",
                  "Harvey",
                  "Murdock",
                  "Lupin",
                  "Hamilton",
                  "Jarvis",
                  "Watson",
                  "Glenn"
                ]
              },
              "tokens_input": {
                "type": "integer",
                "minimum": 0
              },
              "tokens_output": {
                "type": "integer",
                "minimum": 0
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "latency_ms": {
                "type": "integer",
                "minimum": 0
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "input_rate_per_million": {
                "type": "number",
                "minimum": 0
              },
              "output_rate_per_million": {
                "type": "number",
                "minimum": 0
              },
              "pricing_source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "event_id",
              "agent",
              "tokens_input",
              "tokens_output",
              "model",
              "latency_ms",
              "cost_usd",
              "input_rate_per_million",
              "output_rate_per_million",
              "pricing_source"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "currency",
        "pricing_status",
        "total_usd",
        "events"
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "preview",
            "production"
          ]
        },
        "contains_sensitive_data": {
          "type": "boolean"
        },
        "redacted_for_public": {
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "contains_sensitive_data",
        "redacted_for_public"
      ]
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elevenlabs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "agent_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "enabled",
            "agent_id"
          ]
        }
      },
      "required": [
        "elevenlabs"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "mode",
    "title",
    "created_at",
    "jurisdiction",
    "context",
    "security",
    "versions",
    "audits",
    "house",
    "changelog",
    "fury",
    "human_approval",
    "reports",
    "costs",
    "publication",
    "integrations"
  ]
}
