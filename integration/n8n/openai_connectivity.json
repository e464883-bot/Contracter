      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\":\"gpt-6-luna\",\"store\":false,\"max_output_tokens\":64,\"reasoning\":{\"effort\":\"none\"},\"input\":\"Synthetic connectivity check. Return status ok.\",\"text\":{\"format\":{\"type\":\"json_schema\",\"name\":\"contracter_connectivity\",\"strict\":true,\"schema\":{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"ok\"]}},\"required\":[\"status\"],\"additionalProperties\":false}}}}",
        "options": {
          "timeout": 35000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "id": "3198fb52-a6da-4927-9668-ee6d19acacd8",
      "name": "Resultado de conexión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst body = response.body;\nconst parts = (body?.output || []).flatMap(item => item.content || []);\nlet value = null;\ntry { value = JSON.parse(parts.find(part => part.type === 'output_text')?.text || 'null'); } catch {}\nreturn [{ json: {\n  connected: response.statusCode === 200 && body?.status === 'completed' && value?.status === 'ok',\n  http_status: response.statusCode || null,\n  provider_error: body?.error?.code || body?.error?.type || (response.error ? 'network_or_credential' : null),\n  model: body?.model || null,\n  input_tokens: body?.usage?.input_tokens ?? null,\n  output_tokens: body?.usage?.output_tokens ?? null,\n} }];"
      }
    }
