# CONTRACTER: chasis local, sin servicios activos ni secretos reales.
# Copia esta plantilla a la configuración privada de tu instancia n8n.
# No publiques un .env real, contratos privados ni credenciales en GitHub Pages.
# El frontend estático NO lee .env: sólo consume JSON público ya anonimizado.
# Primero importa los dos JSON de n8n y ejecuta su Manual Trigger en mock.
# Los adaptadores live permanecen cerrados hasta implementarlos, autenticarlos
# y probarlos; llenar estas variables por sí solo NO los activa.
CONTRACTER_MODE=mock
CONTRACTER_MAX_ROUNDS=3
CONTRACTER_MAX_RETRIES=2
CONTRACTER_REQUIRE_HUMAN_APPROVAL=true
CONTRACTER_PUBLISH_ENABLED=false
CONTRACTER_COST_CURRENCY=USD

# Gateway local Node.js 24+ (backend/server.mjs). No requiere instalar Supabase.
# Escucha únicamente en 127.0.0.1; el modo mock inicia sin claves.
CONTRACTER_PORT=8780
CONTRACTER_SQLITE_PATH=
# Live exige un token aleatorio de al menos 32 caracteres. Nunca incluirlo en HTML.
CONTRACTER_DASHBOARD_TOKEN=
# Opcional. Limita un panel live con token de lectura a un solo expediente sintético.
CONTRACTER_DASHBOARD_EVALUATION_CASE_ID=
# Vacío permite sólo el mismo origen. Separar orígenes HTTPS autorizados por coma.
CONTRACTER_ALLOWED_ORIGINS=
CONTRACTER_LEGAL_RAG_ENABLED=false

# LLM: sólo backend. El modo mock no usa estas variables ni consume tokens.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=TODO_INSERT_KEY_HERE
LLM_MODEL=gpt-6-luna
# Tarifas verificadas por millón de tokens; vacío significa pendiente, nunca 0.
LLM_INPUT_USD_PER_MILLION=0.10
LLM_OUTPUT_USD_PER_MILLION=0.50
LLM_PRICING_SOURCE=https://developers.openai.com/api/docs/pricing
LLM_PRICING_VERIFIED_AT=2026-11-04

# Telegram: canal y abogado autorizado se validan en servidor, no en el mensaje.
TELEGRAM_BOT_TOKEN=TODO_INSERT_KEY_HERE
TELEGRAM_CHAT_ID=TODO_INSERT_KEY_HERE
TELEGRAM_APPROVER_USER_IDS=TODO_INSERT_KEY_HERE
TELEGRAM_WEBHOOK_SECRET=TODO_INSERT_KEY_HERE
# Vacío por defecto. Sólo servidor: mínimo 32 caracteres aleatorios en producción.
# Emite la firma después de autenticar al abogado y vincular su decisión a V2.
CONTRACTER_APPROVAL_HMAC_KEY=

# Supabase/PostgreSQL: nunca exponer service_role o DATABASE_URL al navegador.
SUPABASE_URL=TODO_INSERT_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=TODO_INSERT_KEY_HERE
# Alternativa moderna sb_secret_: sólo servidor; no es un JWT.
SUPABASE_SECRET_KEY=
# Token con alcance dashboard de contracter-store. Sólo backend, nunca HTML.
CONTRACTER_STORE_READ_TOKEN=
DATABASE_URL=TODO_INSERT_KEY_HERE

# n8n: URLs y secretos de entrada/salida preparados, sin webhooks activos.
N8N_BASE_URL=TODO_INSERT_KEY_HERE
N8N_FULL_AUDIT_WEBHOOK_URL=TODO_INSERT_KEY_HERE
N8N_FAST_QA_WEBHOOK_URL=TODO_INSERT_KEY_HERE
N8N_APPROVAL_WEBHOOK_URL=TODO_INSERT_KEY_HERE
N8N_WEBHOOK_SECRET=TODO_INSERT_KEY_HERE

# Sherlock y Murdock: investigación/RAG NO implementados en la demostración.
WEB_SEARCH_BASE_URL=TODO_INSERT_KEY_HERE
WEB_SEARCH_API_KEY=TODO_INSERT_KEY_HERE
LEGAL_RAG_BASE_URL=TODO_INSERT_KEY_HERE
LEGAL_RAG_API_KEY=TODO_INSERT_KEY_HERE
LEGAL_JURISDICTION_COUNTRY=TODO_INSERT_KEY_HERE
LEGAL_JURISDICTION_REGION=TODO_INSERT_KEY_HERE

# GitHub: escritura/despliegue únicamente tras aprobación humana autenticada.
GITHUB_TOKEN=TODO_INSERT_KEY_HERE
GITHUB_REPOSITORY=TODO_INSERT_KEY_HERE
GITHUB_BRANCH=main
GITHUB_CASE_DATA_PATH=docs/data

# ElevenLabs: voz apagada por defecto. Requiere CONTRACTER_DASHBOARD_TOKEN.
ELEVENLABS_ENABLED=false
ELEVENLABS_AGENT_ID=TODO_INSERT_KEY_HERE
ELEVENLABS_AGENT_BRANCH_ID=
ELEVENLABS_API_KEY=TODO_INSERT_KEY_HERE
ELEVENLABS_SIGNED_URL_ENDPOINT=TODO_INSERT_KEY_HERE
